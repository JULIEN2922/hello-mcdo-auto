{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "./dist/server",
    "rootDir": "./server",
    "lib": ["ES2020", "DOM"],
    "jsx": "preserve"
  },
  "include": ["server/**/*"],
  "exclude": ["node_modules", "dist", "src"]
}
